
# =========================================================
# MARKOWITZ | PORTFOLIO ANALYTICS
# Git ignore configuration
# =========================================================


# Python bytecode and cache

__pycache__/
*.py[cod]
*$py.class
*.so


# Python virtual environments

.venv/
venv/
env/
ENV/
.python-version.local


# Environment variables and credentials

.env
.env.*
!.env.example

secrets.toml
credentials.json
*.pem
*.key


# Python distribution and packaging

build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/


# Testing and coverage

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/


# Code quality tools

.mypy_cache/
.ruff_cache/
.pyre/
.pytype/


# Jupyter notebooks

.ipynb_checkpoints/


# IDEs and code editors

.vscode/
.idea/
.spyderproject
.spyproject
*.swp
*.swo


# Operating system files

.DS_Store
Thumbs.db
Desktop.ini


# Logs and temporary files

*.log
logs/
*.tmp
*.temp
*.bak
*.pid


# Application cache and local runtime files

.cache/
cache/
instance/
tmp/
temp/


# Local financial data

data/raw/
data/cache/
data/processed/
downloads/
exports/


# Local databases

*.db
*.sqlite
*.sqlite3


# Deployment-specific local files

.render/


# Legacy Streamlit configuration

.streamlit/
